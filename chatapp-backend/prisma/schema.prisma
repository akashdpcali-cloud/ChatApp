generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageType {
  TEXT
  IMAGE
}

model User {
  id                   String    @id @default(cuid())
  fullName             String
  email                String    @unique
  password             String
  profilePicture       String    @default("/images/chatapp-default-avatar.jpeg")
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  createdGroups Chat[] @relation("GroupCreator")

  participants ChatParticipant[]
  messages     Message[]
}

model Chat {
  id         String   @id @default(cuid())
  isGroup    Boolean  @default(false)
  groupName  String?
  groupImage String   @default("/images/chatapp-default-group.jpeg")

  creatorId  String?
  creator    User?    @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  participants ChatParticipant[]
  messages     Message[]
}

model ChatParticipant {
  id String @id @default(cuid())

  chatId String
  userId String

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
}

model Message {
  id          String      @id @default(cuid())
  content     String
  messageType MessageType @default(TEXT)

  senderId String
  chatId   String

  status     MessageStatus @default(SENT)

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}


enum MessageStatus {
  SENT
  READ
}